# Example koncreet.conf - copy and edit, then:
#   sudo ./koncreet apply --config ./koncreet.conf --yes
#   sudo ./koncreet --dry-run apply -c ./koncreet.conf

# Comma-separated modules in recommended order
modules=baseline,firewall,fail2ban,updates,ssh

# Non-root sudo user to create (blank = skip user creation)
user=deploy

# Optional: install this pubkey for the user (or use pubkey_file=)
# pubkey=ssh-ed25519 AAAA... comment
# pubkey_file=/root/.ssh/authorized_keys

# Extra ufw services besides SSH (comma-separated). See: koncreet firewall list
firewall_services=https

# Extra raw ports (N/tcp or N/udp), comma-separated
# firewall_ports=8080/tcp,8443/tcp

# Allow sensitive services (mysql, vsftpd) to the world - default false
firewall_public=false

# fail2ban jails (comma-separated). See: koncreet fail2ban list
fail2ban_services=ssh

# Disable password + root SSH login (requires non-root user with keys)
ssh_harden=true

# Automatic reboot after kernel updates (default false - safer for beginners)
auto_reboot=false
reboot_hour=04:00

# Optional timezone (e.g. UTC, America/New_York). Blank = leave unchanged
timezone=
